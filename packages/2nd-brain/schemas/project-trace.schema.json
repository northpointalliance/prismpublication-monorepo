{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prism://schemas/project-trace",
  "title": "Project cost trace",
  "description": "Public build-log trace consumed by Convo Margin. Matches the existing project-traces JSON shape.",
  "type": "object",
  "required": ["project", "project_url", "agent_sessions", "estimated_llm_spend_usd", "revenue_usd", "updated_at", "rows"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string" },
    "project_url": { "type": "string" },
    "blog_index_url": { "type": "string" },
    "convomargin_build_log_url": { "type": "string" },
    "agent_sessions": { "type": "integer", "minimum": 0 },
    "estimated_llm_spend_usd": { "type": "number", "minimum": 0 },
    "revenue_usd": { "type": "number", "minimum": 0 },
    "margin_usd": {
      "type": "number",
      "description": "revenue_usd minus estimated_llm_spend_usd. Negative is expected pre-revenue."
    },
    "updated_at": { "type": "string", "format": "date" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when", "event", "event_type", "outcome", "estimated_cost_usd"],
        "additionalProperties": false,
        "properties": {
          "when": {
            "type": "string",
            "description": "Short display date, for example \"Aug 20\"."
          },
          "event": { "type": "string" },
          "event_type": { "type": "string" },
          "outcome": { "type": "string" },
          "estimated_cost_usd": { "type": "number", "minimum": 0 },
          "prompt_excerpt": { "type": "string", "maxLength": 240 },
          "blog_slug": { "type": "string" },
          "blog_url": { "type": "string" }
        }
      }
    }
  }
}
